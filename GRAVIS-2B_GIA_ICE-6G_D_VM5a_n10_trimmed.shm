header:
  dimensions:
    degree                : 256
    order                 : 256

  non-standard_attributes:
    product_id            : GRAVIS-2B
    format_id             :
      short_name          : SHM
      long_name           : Earth Gravity Spherical Harmonic Model Format
    normalization         : fully normalized
    earth_gravity_param   :
      long_name           : gravitational constant times mass of Earth
      units               : m3/s2
      value               : 3.9860044150E+14
    mean_equator_radius   :
      long_name           : mean equator radius
      units               : meters
      value               : 6.3781364600E+06

  global_attributes:
    title                 : GIA model applied as correction for GravIS Level-2B products.
    summary               : Model which is subtracted from GravIS Level-2B products to correct for the linear trend caused by Glacial Isostatic Adjustment (GIA). The spherical harmonic coefficients are taken from the file 'ICE-6G_D STOKES' which is provided as supporting information of Peltier et al. (2018) (see references below). The keyword 'GRDOTA' below denotes that the Clm/Slm coefficents represent linear trend per year.
    keywords              : GIA, Glacial Isostatic Adjustment, GRACE, GRACE-FO, Level-2B, SHM, Spherical Harmonic Model, Gravitational Field, Geopotential, Gravity Field, Mass, Mass Transport, Total Water Storage, Time Variable Gravity, Mass Balance, Gravity Anomaly, Satellite Geodesy
    keywords_vocabulary   : NASA Global Change Master Directory (GCMD) Science Keywords
    institution           : GFZ Helmholtz Centre for Geosciences
    conventions           : CF-1.6, ACDD-1.3, ISO 8601
    id                    : 10.5880/COST-G.GRAVIS_02_L2B
    naming_authority      : doi.org/
    history               : Original solution produced on 2020-04-14T12:00:00
    processing_level      : 2B
    acknowledgement       : Use "Dahle, Christoph; Murboeck, Michael (2025). Post-processed GRACE/GRACE-FO Geopotential GSM Coefficients COST-G RL02 (Level-2B Product). V. 0001. GFZ Data Services. https://doi.org/10.5880/COST-G.GRAVIS_02_L2B" when citing this data.
    license               : https://creativecommons.org/licenses/by/4.0/
    product_version       : 0001
    references            :
      - https://gravis.gfz.de/corrections
      - Peltier, W.R., Argus, D.F., Drummond, R. (2018). Comment on "An assessment of the ICE-6G_C (VM5a) glacial isostatic adjustment model" by Purcell et al. Journal of Geophysical Research, Solid Earth, 123, 2019-2028. https://doi.org/10.1002/2016JB013844
    creator_name          : GFZ GRACE/GRACE-FO Science Data System
    creator_email         : grace@gfz.de
    creator_url           : https://www.gfz.de/en/grace-fo/
    creator_type          : group
    creator_institution   : GFZ Helmholtz Centre for Geosciences
    publisher_name        : GFZ Data Services
    publisher_email       : grace@gfz.de
    publisher_url         : https://dataservices.gfz.de/
    publisher_type        : group
    publisher_institution : GFZ Helmholtz Centre for Geosciences
    date_created          : 2020-04-14T12:00:00
    date_issued           : 2020-06-09T12:00:00

  variables:
    record_key:
      key_name              : GRDOTA
      long_name             : Earth Gravity Spherical Harmonic Model Format Type
      coverage_content_type : referenceInformation
      data_type             : string
      comment               : 1st column
    degree_index:
      long_name             : spherical harmonic degree l
      coverage_content_type : referenceInformation
      data_type             : int32
      comment               : 2nd column
    order_index:
      long_name             : spherical harmonic order m
      coverage_content_type : referenceInformation
      data_type             : int32
      comment               : 3rd column
    clm:
      long_name             : Clm coefficient; cosine coefficient for degree l and order m
      data_type             : double precision
      comment               : 4th column
    slm:
      long_name             : Slm coefficient; sine coefficient for degree l and order m
      data_type             : double precision
      comment               : 5th column
