      value               : 3.9860044150E+14
    mean_equator_radius   :
      long_name           : mean equator radius
      units               : meters
      value               : 6.3781364600E+06
    comments              : formal sigmas are not calibrated

  global_attributes:
    title                 : GRACE Geopotential GSM Coefficients GFZ RL06 - Mean Field 2002/04 till 2020/03
    summary               : Long-term mean field calculated as unweighted average of the 183 available GFZ RL06 GSM products in the period from 2002/04 up to and including 2020/03. These coefficients represent the full magnitude of land hydrology, ice, and solid Earth processes. Further, they represent atmospheric and oceanic processes not captured in the accompanying GAC product. The reference epoch of this mean field is 2010/08/16.
    keywords              : GRACE, GRACE-FO, Level-2, Level-2B, SHM, Spherical Harmonic Model, Gravitational Field, GSM, Geopotential, Gravity Field, Mass, Mass Transport, Total Water Storage, Time Variable Gravity, Mass Balance, Gravity Anomaly, Satellite Geodesy
    keywords_vocabulary   : NASA Global Change Master Directory (GCMD) Science Keywords
    institution           : GFZ Helmholtz Centre for Geosciences
    conventions           : CF-1.6, ACDD-1.3, ISO 8601
    id                    : 10.5880/COST-G.GRAVIS_02_L2B
    naming_authority      : doi.org/
    history               : Original solution produced on 2020-04-21T12:00:00
    source                : GFZ RL06 Level-2 GSM products 'GSM-2_*_GFZOP_BB01_0600'
    processing_level      : 2B
